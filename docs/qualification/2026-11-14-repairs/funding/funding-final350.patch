+#[test]
+fn v16_program_fixed_report_history_preserves_funding_across_settlement_cadence() {
+    let delayed = run_report_cadence(1_000, false, &[8, 14]);
+    let eager = run_report_cadence(1_000, true, &[8, 14]);
+    assert_eq!(
+        delayed, eager,
+        "the same authenticated report history must preserve settled liquidation outcomes"
+    );
+}
+
+// A report renewal changes the funding-mark checkpoint, so different report
+// histories need not have equal funding or liquidation quantities. Remove only
+// the independently input-derived funding and the explicitly checked liquidation
+// transfers; the residual price-only entitlement and insurance stock must agree.
+type CadenceOutcome = (u128, u128, u128, [i128; 5], u128);
+
+fn report_history_economic_basis(
+    outcome: &CadenceOutcome,
+    funding_atoms: [i128; 4],
+) -> ([i128; 5], u128) {
+    let mut values = outcome.3;
+    for (value, funding) in values.iter_mut().zip(funding_atoms) {
+        *value -= funding;
+    }
+    values[0] += outcome.1 as i128;
+    values[4] -= outcome.2 as i128;
+    let insurance_basis = outcome
+        .4
+        .checked_add(outcome.2)
+        .unwrap()
+        .checked_sub(outcome.1)
+        .unwrap();
+    (values, insurance_basis)
 }
 
