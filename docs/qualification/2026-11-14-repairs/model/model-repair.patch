+#[cfg(test)]
+mod effective_oi_rounding_regressions {
+    use super::*;
+
+    #[test]
+    fn ceil_leg_sums_reconcile_with_equal_aggregate_oi_without_tolerance() {
+        let index = IndependentAdlIndex::INITIAL
+            .unilateral_reduction(2, 1)
+            .unwrap();
+        assert_eq!(index.a, ADL_ONE / 2);
+        let long = reconcile_effective_oi_rounding(index.a, 2, 2, 2, 1).unwrap();
+        let short = reconcile_effective_oi_rounding(ADL_ONE, 1, 1, 1, 1).unwrap();
+        assert_eq!(long.leg_ceiling_num, ADL_ONE);
+        assert_eq!(long.index_bookkeeping_num, 0);
+        assert_eq!(long.census_minus_aggregate_q, 1);
+        assert_eq!(short, EffectiveOiRoundingResidue::default());
+        assert!(reconcile_effective_oi_rounding(index.a, 2, 2, 3, 1).is_err());
+    }
+
+    #[test]
+    fn repeated_index_flooring_has_signed_residue_larger_than_one_atom_per_leg() {
+        let raw = 70_000_000_000_000u128;
+        let mut aggregate = raw;
+        let mut index = IndependentAdlIndex::INITIAL;
+        for _ in 0..40 {
+            index = index.unilateral_reduction(aggregate, 1).unwrap();
+            aggregate -= 1;
+        }
+        assert_eq!(index.a, 999_999_999_999_400);
+        assert_eq!(aggregate, 69_999_999_999_960);
+        let census = super::super::reference_math::mul_div_ceil(raw, index.a, ADL_ONE).unwrap();
+        assert_eq!(census, 69_999_999_999_958);
+        let residue = reconcile_effective_oi_rounding(index.a, raw, 1, census, aggregate).unwrap();
+        assert_eq!(residue.leg_ceiling_num, 0);
+        assert_eq!(residue.index_bookkeeping_num, -2 * ADL_ONE as i128);
+        assert_eq!(residue.census_minus_aggregate_q, -2);
+    }
+
+    #[test]
+    fn independent_indices_basis_and_aggregate_reject_one_atom_mutations() {
+        let index = IndependentAdlIndex::INITIAL
+            .unilateral_reduction(2, 1)
+            .unwrap();
+        let mut asset = AssetStateV16::default();
+        asset.a_long = index.a;
+        asset.oi_eff_long_q = 1;
+        assert_eq!(index.reconcile(&asset, 0, 1, 0).unwrap(), index);
+        asset.a_long += 1;
+        assert!(
+            index.reconcile(&asset, 0, 1, 0).is_err(),
+            "wrong A must fail independently of census"
+        );
+        asset.a_long = index.a;
+        asset.oi_eff_long_q += 1;
+        assert!(
+            index.reconcile(&asset, 0, 1, 0).is_err(),
+            "wrong aggregate must fail independently of census"
+        );
+        asset.oi_eff_long_q = 1;
+        assert!(
+            index.reconcile(&asset, 0, 2, 0).is_err(),
+            "wrong shadow ledger must fail"
+        );
+        asset.epoch_long = 1;
+        asset.a_long = ADL_ONE;
+        asset.mode_long = SideModeV16::ResetPending;
+        assert!(
+            index.reconcile(&asset, 0, 1, 0).is_err(),
+            "reset with nonzero OI must fail"
+        );
+        asset.oi_eff_long_q = 0;
+        assert_eq!(
+            index.reconcile(&asset, 0, 0, 0).unwrap(),
+            IndependentAdlIndex {
+                a: ADL_ONE,
+                epoch: 1,
+                reset_pending: true,
+                reset_confirmation_due: false,
+            }
+        );
+        asset.pending_obligation_count_long = 1;
+        assert!(
+            index.reconcile(&asset, 0, 0, 0).is_err(),
+            "reset with pending loss must fail"
+        );
+        let mut leg = PortfolioLegV16::EMPTY;
+        leg.a_basis = ADL_ONE;
+        assert_public_leg_adl_basis(leg).unwrap();
+        leg.a_basis -= 1;
+        assert!(
+            assert_public_leg_adl_basis(leg).is_err(),
+            "wrong birth basis must fail"
+        );
+    }
+
+    #[test]
+    fn capped_dead_leg_removal_requires_a_typed_terminal_witness() {
+        assert_eq!(account_oi_removal(2, 3, None).unwrap(), 2);
+        assert!(
+            account_oi_removal(2, 1, None).is_err(),
+            "ordinary Live removals remain strict"
+        );
+        for witness in [
+            DeadLegRemovalWitness::ResolvedExit,
+            DeadLegRemovalWitness::RecoveryForfeit,
+        ] {
+            assert_eq!(account_oi_removal(2, 1, Some(witness)).unwrap(), 1);
+            assert_eq!(account_oi_removal(4, 1, Some(witness)).unwrap(), 1);
+            assert_eq!(account_oi_removal(2, 0, Some(witness)).unwrap(), 0);
+        }
+        assert_eq!(
+            account_oi_removal(2, 0, Some(DeadLegRemovalWitness::ZeroOiResidue)).unwrap(),
+            0
+        );
+        assert!(account_oi_removal(2, 1, Some(DeadLegRemovalWitness::ZeroOiResidue)).is_err());
+        let index = IndependentAdlIndex::INITIAL;
+        assert!(index.unilateral_reduction(1, 2).is_err());
+        let mut asset = AssetStateV16::default();
+        asset.oi_eff_long_q = 1;
+        assert!(DeadLegRemovalWitness::from_prestate(MarketModeV16::Live, &asset, 0).is_err());
+        asset.lifecycle = AssetLifecycleV16::Recovery;
+        assert_eq!(
+            DeadLegRemovalWitness::from_prestate(MarketModeV16::Live, &asset, 0).unwrap(),
+            DeadLegRemovalWitness::RecoveryForfeit
+        );
+    }
+
+    #[test]
+    fn exhausted_unilateral_side_requires_one_reset_and_no_repeated_reset() {
+        let index = IndependentAdlIndex::INITIAL
+            .unilateral_reduction(1, 1)
+            .unwrap();
+        assert_eq!(index.epoch, 1);
+        assert!(index.reset_pending);
+        let mut asset = AssetStateV16::default();
+        assert!(
+            index.reconcile(&asset, 0, 0, 0).is_err(),
+            "missing epoch/reset must fail"
+        );
+        asset.epoch_long = 1;
+        assert!(
+            index.reconcile(&asset, 0, 0, 0).is_err(),
+            "required reset mode must not be skipped"
+        );
+        asset.mode_long = SideModeV16::ResetPending;
+        asset.pending_obligation_count_long = 1;
+        assert!(
+            index.reconcile(&asset, 0, 0, 0).is_err(),
+            "predicted reset must have no pending obligations"
+        );
+        asset.pending_obligation_count_long = 0;
+        assert!(
+            index.reconcile(&asset, 0, 0, 1).is_err(),
+            "predicted reset must have no pending domain loss barrier"
+        );
+        let confirmed = index.reconcile(&asset, 0, 0, 0).unwrap();
+        assert_eq!(
+            confirmed,
+            IndependentAdlIndex {
+                reset_confirmation_due: false,
+                ..index
+            }
+        );
+        asset.epoch_long = 2;
+        assert!(
+            confirmed.reconcile(&asset, 0, 0, 0).is_err(),
+            "already pending side must not reset again"
+        );
+        asset.epoch_long = 1;
+        asset.mode_long = SideModeV16::Normal;
+        assert!(
+            confirmed.reconcile(&asset, 0, 0, 1).is_err(),
+            "reset finalization must have no pending domain loss barrier"
+        );
+    }
+
+    #[test]
+    fn canonical_resize_rejects_a_raw_atom_hidden_by_the_same_ceil_quantity() {
+        let a = ADL_ONE / 2;
+        let effective = |raw| super::super::reference_math::mul_div_ceil(raw, a, ADL_ONE).unwrap();
+        assert_eq!(effective(5), 3);
+        assert_eq!(effective(4), 2);
+        assert_eq!(effective(3), 2);
+        let canonical = canonical_resized_raw_basis(5, 2, ADL_ONE, a).unwrap();
+        assert_eq!(canonical, 4);
+        assert_ne!(
+            canonical, 3,
+            "the same effective delta must not hide noncanonical raw basis"
+        );
+        assert_exhausted_reset_quantity(3, 2, 1).unwrap();
+        assert!(
+            assert_exhausted_reset_quantity(3, 1, 1).is_err(),
+            "reset must not hide an extra quantity closed"
+        );
+        assert!(
+            assert_exhausted_reset_quantity(3, 3, 1).is_err(),
+            "reset must not hide a missing quantity closed"
+        );
+    }
+}
