+// This is a transition ledger, not a copy of the deployed A index. Public
+// attachments start at unit A; only a witnessed unilateral close floors the
+// opposite index, and only an exhausted epoch can reset it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+struct IndependentAdlIndex {
+    a: u128,
+    epoch: u64,
+    reset_pending: bool,
+    reset_confirmation_due: bool,
+}
+
+impl IndependentAdlIndex {
+    const INITIAL: Self = Self {
+        a: ADL_ONE,
+        epoch: 0,
+        reset_pending: false,
+        reset_confirmation_due: false,
+    };
+
+    fn unilateral_reduction(self, before_oi: u128, reduce_q: u128) -> Result<Self, String> {
+        let after_oi = before_oi
+            .checked_sub(reduce_q)
+            .ok_or("independent A reduction exceeds aggregate OI")?;
+        if reduce_q == 0 {
+            return Ok(self);
+        }
+        if self.reset_pending {
+            return Err("unilateral close cannot reduce a prior-reset side".into());
+        }
+        let a = if after_oi == 0 {
+            ADL_ONE
+        } else {
+            super::reference_math::mul_div_floor(self.a, after_oi, before_oi)?
+        };
+        if a == 0 {
+            return Err("successful independent A transition reached zero".into());
+        }
+        Ok(if after_oi == 0 {
+            Self {
+                a,
+                epoch: self
+                    .epoch
+                    .checked_add(1)
+                    .ok_or("independent reset epoch overflow")?,
+                reset_pending: true,
+                reset_confirmation_due: true,
+            }
+        } else {
+            Self { a, ..self }
+        })
+    }
+
+    fn reconcile(
+        self,
+        asset: &AssetStateV16,
+        side: usize,
+        expected_oi: u128,
+        pending_domain_loss_barrier: u64,
+    ) -> Result<Self, String> {
+        let (a, epoch, oi, pending, stored, stale, mode) = if side == 0 {
+            (
+                asset.a_long,
+                asset.epoch_long,
+                asset.oi_eff_long_q,
+                asset.pending_obligation_count_long,
+                asset.stored_pos_count_long,
+                asset.stale_account_count_long,
+                asset.mode_long,
+            )
+        } else {
+            (
+                asset.a_short,
+                asset.epoch_short,
+                asset.oi_eff_short_q,
+                asset.pending_obligation_count_short,
+                asset.stored_pos_count_short,
+                asset.stale_account_count_short,
+                asset.mode_short,
+            )
+        };
+        if oi != expected_oi {
+            return Err(format!(
+                "deployed aggregate OI {oi} != independent ledger {expected_oi}"
+            ));
+        }
+        if mode == SideModeV16::ResetPending
+            && (oi != 0 || pending != 0 || pending_domain_loss_barrier != 0)
+        {
+            return Err(
+                "reset side retained OI, pending obligation, or domain loss barrier".into(),
+            );
+        }
+        if epoch == self.epoch && a == self.a {
+            if self.reset_confirmation_due && mode != SideModeV16::ResetPending {
+                return Err("unilateral exhaustion did not install its required reset mode".into());
+            }
+            if self.reset_pending != (mode == SideModeV16::ResetPending) {
+                if self.reset_pending
+                    && mode == SideModeV16::Normal
+                    && oi == 0
+                    && pending == 0
+                    && stored == 0
+                    && stale == 0
+                    && pending_domain_loss_barrier == 0
+                {
+                    return Ok(Self {
+                        reset_pending: false,
+                        ..self
+                    });
+                }
+                return Err(
+                    "side reset mode changed without its exact epoch/finalization witness".into(),
+                );
+            }
+            return Ok(Self {
+                reset_confirmation_due: false,
+                ..self
+            });
+        }
+        if !self.reset_pending
+            && self.epoch.checked_add(1) == Some(epoch)
+            && oi == 0
+            && pending == 0
+            && mode == SideModeV16::ResetPending
+            && a == ADL_ONE
+        {
+            return Ok(Self {
+                a: ADL_ONE,
+                epoch,
+                reset_pending: true,
+                reset_confirmation_due: false,
+            });
+        }
+        Err(format!(
+            "deployed A/epoch {a}/{epoch} != independent {}/{} without an exhausted-epoch reset",
+            self.a, self.epoch
+        ))
+    }
+}
+
+// All legs in this public ScenarioRunner are attached/flipped only at unit A;
+// same-side reductions preserve that birth basis. Keep this explicit so a
+// corrupted basis cannot be explained away as rounding.
+fn assert_public_leg_adl_basis(leg: PortfolioLegV16) -> Result<(), String> {
+    if leg.a_basis != ADL_ONE {
+        return Err(format!(
+            "public leg birth A {} != independent unit basis {ADL_ONE}",
+            leg.a_basis
+        ));
+    }
+    Ok(())
+}
+
+fn canonical_resized_raw_basis(
+    old_raw_q: u128,
+    new_effective_q: u128,
+    a_basis: u128,
+    a: u128,
+) -> Result<u128, String> {
+    let old_effective_q = super::reference_math::mul_div_ceil(old_raw_q, a, a_basis)?;
+    let candidate = super::reference_math::mul_div_floor(new_effective_q, a_basis, a)?;
+    Ok(if new_effective_q <= old_effective_q {
+        candidate.min(old_raw_q)
+    } else {
+        candidate
+    })
+}
+
+fn assert_exhausted_reset_quantity(
+    old_effective_q: u128,
+    remaining_before_reset_q: u128,
+    ledger_before_q: u128,
+) -> Result<(), String> {
+    if old_effective_q.checked_sub(remaining_before_reset_q) != Some(ledger_before_q) {
+        return Err(
+            "retained reset residue does not account for the exact exhausted aggregate quantity"
+                .into(),
+        );
+    }
+    Ok(())
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
+struct EffectiveOiRoundingResidue {
+    // Denominator ADL_ONE. Ceil rounding is nonnegative; repeated index flooring
+    // and capped terminal removals make the index/bookkeeping term signed.
+    leg_ceiling_num: u128,
+    index_bookkeeping_num: i128,
+    census_minus_aggregate_q: i128,
+}
+
+fn reconcile_effective_oi_rounding(
+    a: u128,
+    raw_current_q: u128,
+    current_leg_count: u64,
+    census_q: u128,
+    aggregate_q: u128,
+) -> Result<EffectiveOiRoundingResidue, String> {
+    let exact_num = raw_current_q
+        .checked_mul(a)
+        .ok_or("exact exposure numerator overflow")?;
+    let census_num = census_q
+        .checked_mul(ADL_ONE)
+        .ok_or("census exposure numerator overflow")?;
+    let aggregate_num = aggregate_q
+        .checked_mul(ADL_ONE)
+        .ok_or("aggregate exposure numerator overflow")?;
+    let leg_ceiling_num = census_num
+        .checked_sub(exact_num)
+        .ok_or("leg ceiling residue is negative")?;
+    let ceiling_bound = u128::from(current_leg_count)
+        .checked_mul(ADL_ONE)
+        .ok_or("leg ceiling bound overflow")?;
+    if (current_leg_count == 0 && leg_ceiling_num != 0)
+        || (current_leg_count != 0 && leg_ceiling_num >= ceiling_bound)
+    {
+        return Err("leg ceiling residue violates its exact per-leg bound".into());
+    }
+    let signed = |value| {
+        i128::try_from(value).map_err(|_| "rounding numerator exceeds signed range".to_string())
+    };
+    let index_bookkeeping_num = signed(exact_num)?
+        .checked_sub(signed(aggregate_num)?)
+        .ok_or("index bookkeeping residue overflow")?;
+    let census_minus_aggregate_q = signed(census_q)?
+        .checked_sub(signed(aggregate_q)?)
+        .ok_or("census/aggregate residue overflow")?;
+    if index_bookkeeping_num.checked_add(signed(leg_ceiling_num)?)
+        != census_minus_aggregate_q.checked_mul(signed(ADL_ONE)?)
+    {
+        return Err("effective OI rounding decomposition is not exact".into());
+    }
+    Ok(EffectiveOiRoundingResidue {
+        leg_ceiling_num,
+        index_bookkeeping_num,
+        census_minus_aggregate_q,
+    })
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum DeadLegRemovalWitness {
+    ResolvedExit,
+    RecoveryForfeit,
+    ZeroOiResidue,
+}
+
+impl DeadLegRemovalWitness {
+    fn from_prestate(
+        market_mode: MarketModeV16,
+        state: &AssetStateV16,
+        side: usize,
+    ) -> Result<Self, String> {
+        if market_mode == MarketModeV16::Resolved {
+            Ok(Self::ResolvedExit)
+        } else if state.lifecycle == AssetLifecycleV16::Recovery {
+            Ok(Self::RecoveryForfeit)
+        } else if [state.oi_eff_long_q, state.oi_eff_short_q][side] == 0 {
+            Ok(Self::ZeroOiResidue)
+        } else {
+            Err("dead-leg cap lacks Resolved, Recovery, or zero-OI residue witness".into())
+        }
+    }
+
+    fn removal(self, effective_q: u128, ledger_q: u128) -> Result<u128, String> {
+        if self == Self::ZeroOiResidue && ledger_q != 0 {
+            return Err("zero-OI residue witness retained independent aggregate OI".into());
+        }
+        Ok(effective_q.min(ledger_q))
+    }
+}
+
+fn account_oi_removal(
+    effective_q: u128,
+    ledger_q: u128,
+    dead_leg_witness: Option<DeadLegRemovalWitness>,
+) -> Result<u128, String> {
+    if let Some(witness) = dead_leg_witness {
+        witness.removal(effective_q, ledger_q)
+    } else if effective_q <= ledger_q {
+        Ok(effective_q)
+    } else {
+        Err("ordinary Live leg removal exceeds independent aggregate OI".into())
+    }
+}
